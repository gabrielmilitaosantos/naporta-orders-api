# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naporta?schema=public"

ADMIN_PASSWORD="password-for-admin-user"

# JWT
# Set a unique random value of at least 32 bytes
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Throttler (rate-limit req/min)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Server
PORT=3000